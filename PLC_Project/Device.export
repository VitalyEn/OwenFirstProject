                <Single Name="Id" Type="long">49</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">tStart := (T#1H * Slot.StartHour) + (T#1M * Slot.StartMin);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">50</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">tStop  := (T#1H * Slot.StopHour)  + (T#1M * Slot.StopMin);</Single>
              </Single>
